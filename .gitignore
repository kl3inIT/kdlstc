__pycache__/
*.py[cod]

.env
.env.*
!.env.example

*.log
.DS_Store
Thumbs.db

# dbt runtime artifacts
platform/dbt/target/
platform/dbt/logs/
platform/dbt/dbt_packages/

# Deployment-specific values stay outside the public repository
platform/helm/*-values.local.yaml
platform/k8s/*.local.yaml

# Build output of the khaithac web UI. The source lives in khaithac/web/src and
# `pnpm build` regenerates these bundles byte for byte, so committing them only
# buys 13 MB of churn on top of the 102 KB of Java they are served from.
khaithac/src/main/resources/static/assets/

# Charts pulled from an upstream repository, restorable with `helm pull`
platform/vendor/*.tgz

# Browser state captured during Playwright verification runs
.playwright-cli/

# Skill của dự án khác, không thuộc kho mã này
.skills/
.agents/
.claude/skills/

# Refine frontend runtime artifacts
frontend/node_modules/
frontend/dist/

# Spring backend runtime artifacts
backend/.gradle/
backend/build/
backend/node_modules/
